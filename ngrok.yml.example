# NO pongas solo authtoken aquí si ya usaste `ngrok config add-authtoken`:
# al arrancar hay que combinar este archivo con el ngrok.yml global (ver NGROK.md).
#
# Copia a `ngrok.yml` en la raíz del repo:
#   copy ngrok.yml.example ngrok.yml   (Windows)
#
# Comando típico (PowerShell), desde la raíz del repo:
#   ngrok start --config "$env:LOCALAPPDATA\ngrok\ngrok.yml" --config ngrok.yml pulse-api pulse-web

version: "2"
tunnels:
  pulse-api:
    proto: http
    addr: 3000
  pulse-web:
    proto: http
    addr: 3001
