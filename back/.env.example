PORT=3000
# En la nube suele ser necesario escuchar en todas las interfaces (por defecto ya es 0.0.0.0).
# Solo local: HOST=127.0.0.1
HOST=

# --- Base de datos ---
# Opción A (recomendada en producción / Neon / Supabase / Railway):
# DATABASE_URL=postgresql://usuario:clave@host.region.provider.com:5432/nombre_db
# Si el host no es localhost y usas DATABASE_URL, se activa TLS salvo que pongas DB_SSL=false.
# DB_SSL=require
# DB_SSL=false

# Opción B (local o Postgres con host explícito):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=proyecto_m4_front

JWT_SECRET=
