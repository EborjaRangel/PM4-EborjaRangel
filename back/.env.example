PORT=3000
# En la nube suele ser necesario escuchar en todas las interfaces (por defecto ya es 0.0.0.0).
# Solo local: HOST=127.0.0.1
HOST=

# =============================================================================
# IMPORTANTE — LOCAL vs NUBE
# =============================================================================
# Si defines DATABASE_URL abajo, SIEMPRE se usa esa cadena y se IGNORAN DB_HOST,
# DB_USER, DB_PASSWORD y DB_NAME.
#
# Para Postgres SOLO en tu PC:
#   - Comenta o borra por completo la linea DATABASE_URL (no dejes la variable vacia
#     mezclada con espacios raros).
#   - Usa solo la "Opcion B" (DB_HOST, DB_USER, ...).
# Opcional: crea `.env.local` en esta carpeta (`back/`) para overrides (no se sube a Git);
#   tiene prioridad sobre `.env`.
#
# Para probar contra Neon/Supabase desde tu laptop:
#   - Pon DATABASE_URL y (opcional) DB_SSL=false si el proveedor lo requiere.
# =============================================================================

# --- Base de datos ---
# Opción A (producción / Neon / Supabase / Railway):
# DATABASE_URL=postgresql://usuario:clave@host.region.provider.com:5432/nombre_db
# Si el host no es localhost y usas DATABASE_URL, se activa TLS salvo que pongas DB_SSL=false.
# DB_SSL=require
# DB_SSL=false

# Opción B (local o Postgres con host explícito):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=proyecto_m4_front

JWT_SECRET=

# --- WhatsApp: aviso al registrarse (CallMeBot, opcional) ---
# El mensaje se envía al celular que el usuario escribió en el registro (sin contraseña).
# Guía: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# WHATSAPP_CALLMEBOT_APIKEY=tu_apikey

# --- Despliegue (Vercel + API en Render/Railway/etc.) ---
# En el proyecto Next.js (Vercel → Environment Variables):
#   PULSE_BACKEND_URL=https://TU-SERVICIO-API.onrender.com
# Sin barra final. Redeploy del front tras cambiarla.
