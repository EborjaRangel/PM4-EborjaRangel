# =============================================================================
# Google Maps (ubicacion en /cart/ubicacion)
# =============================================================================
# 1. Copia este archivo y renómalo a:  .env.local
# 2. Sustituye el valor por tu API key de Google Cloud Console.
# 3. Reinicia el servidor de Next (npm run dev).
#
# En Cloud Console habilita (Libraries/APIs del proyecto):
#   - Maps JavaScript API
#   - Geocoding API
#   - Places API
#
# Restringe la key por HTTP referrer (localhost + tu dominio) en Credentials.
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Alternativa (solo servidor): la pagina /cart/ubicacion la lee y la pasa al mapa.
# GOOGLE_MAPS_API_KEY=

# =============================================================================
# API Express (backend)
# =============================================================================
#
# El navegador usa rutas como /pulse-api-proxy/... sobre el mismo dominio del front.
# PULSE_PROXY_TARGET indica adónde reenvía Next (solo servidor). En local típico 3000 del API:
PULSE_PROXY_TARGET=http://127.0.0.1:3000
#
# Si desplegas el FRONT en la nube (Vercel) y el BACK en Railway/Render/ngrok:
# PULSE_PROXY_TARGET=https://tu-api-publica...
#
# Opcional: llevar todas las llamadas sin proxy (dos dominios en el navegador):
NEXT_PUBLIC_API_URL=
