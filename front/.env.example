# =============================================================================
# Google Maps (ubicacion en /cart/ubicacion)
# =============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# =============================================================================
# API (proxy / ngrok)
# =============================================================================
# Vacío = navegador usa /pulse-api-proxy → localhost:3000 (desarrollo local).
# Con ngrok en el API (puerto 3000), una sola línea:
# NEXT_PUBLIC_API_URL=https://xxxx.ngrok-free.dev

# IPs extra permitidas para HMR dev desde LAN (next.config allowedDevOrigins), separadas por coma:
# ALLOWED_DEV_ORIGINS=192.168.1.10
